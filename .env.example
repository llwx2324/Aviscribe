# Required secrets. Generate unique production values; never commit real credentials.
DB_PASSWORD=replace-with-a-strong-database-password
DB_ROOT_PASSWORD=replace-with-a-different-root-password
DB_USERNAME=aviscribe
AVISCRIBE_JWT_SECRET=replace-with-at-least-32-random-bytes

# Optional production overrides
DB_URL=jdbc:mysql://localhost:3306/aviscribe_db?serverTimezone=UTC&useUnicode=true&characterEncoding=utf-8&useSSL=true
AVISCRIBE_UPLOAD_PATH=/var/lib/aviscribe/files/
ALIYUN_NLS_APP_KEY=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
DS_API_KEY=
DS_BASE_URL=https://api.deepseek.com
DS_MODEL=deepseek-chat
HTTP_PORT=80
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -Duser.timezone=Asia/Shanghai
